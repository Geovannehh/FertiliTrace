generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
// Atomic journal snapshot for this initial single-terminal MVP.
// The shared domain validates each movement; CAS prevents concurrent overspending.
model LedgerState {
  id       String @id
  revision Int @default(0)
  payload  Json
  updatedAt DateTime @updatedAt
  @@map("ledger_states")
}
